[Unit]
Description=Clock-bot Telegram controller
After=network-online.target
Wants=network-online.target

[Service]
User=user
WorkingDirectory=/home/user/clock-bot
ExecStart=/home/user/clock-bot/venv/bin/python /home/user/clock-bot/controller.py
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
