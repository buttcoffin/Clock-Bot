CLOCK_USER=user
CLOCK_PASS=12345678
EMAIL_USER=user
EMAIL_PASS=12345678
SE_OFFLINE=false

# Timeclock site
CLOCK_URL=https://timeclock.com
COMPANY_LINK_TEXT=My Company
FAVORITE_ID=FAVORITE_1

# MFA (SMS forwarded to email)
IMAP_SERVER=imap.gmail.com
MFA_SUBJECT=SMSFW

# Browser / timing
# Random delay only used when clockbot.py is run by hand/cron, not by the controller
MAX_DELAY_SEC=600
PAGE_TIMEOUT_SEC=45
CHROMIUM_PATH=/usr/bin/chromium
CHROMEDRIVER_PATH=/usr/bin/chromedriver

# Telegram remote control (controller.py)
TELEGRAM_TOKEN=123456:ABC-from-BotFather
TELEGRAM_CHAT_ID=123456789
PUNCH_DAYS=mon,tue,wed,thu,fri

# Windows: clock-in and lunch-out are random inside their window every day.
# Lunch length and clock-out are then worked out to hit the hours below,
# keeping clock-out inside its window whenever possible.
PUNCH_IN=07:45-07:55
PUNCH_OUT=16:10-16:20
# Lunch-out window during standard time (Nov-Mar) and DST (Mar-Nov). Blank = no lunch punches.
LUNCH_OUT=11:05-11:20
LUNCH_OUT_DST=12:05-12:20
# Lunch length limits in minutes (unpaid; measured between the real clicks)
LUNCH_MIN=20
LUNCH_MAX=30

# Hours (net of lunch). Each day lands between DAY_MIN and DAY_MAX; the week never
# goes over WEEK_MAX. With all 5 days worked that keeps the week at 40-41 h.
DAY_MIN_HOURS=8
DAY_MAX_HOURS=8.25
WEEK_MAX_HOURS=41

# Start clockbot this many minutes early (room for a retry); it waits on the punch page until the exact time
PUNCH_LEAD_MIN=15
# If a step fails before the click, retry with a fresh browser up to this many times
PUNCH_ATTEMPTS=3
# Never click more than this many minutes after the planned time; fail and alert instead
PUNCH_LATE_MAX_MIN=10
# Never start a punch more than this many minutes late (e.g. after a reboot)
PUNCH_GRACE_MIN=5
