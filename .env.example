CLOCK_USER=user
CLOCK_PASS=12345678
EMAIL_USER=user
EMAIL_PASS=12345678
SE_OFFLINE=false

# Timeclock site
CLOCK_URL=https://timeclock.com
COMPANY_LINK_TEXT=My Company
FAVORITE_ID=FAVORITE_1

# MFA (SMS forwarded to email)
IMAP_SERVER=imap.gmail.com
MFA_SUBJECT=SMSFW

# Browser / timing
# Random delay only used when clockbot.py is run by hand/cron, not by the controller
MAX_DELAY_SEC=600
PAGE_TIMEOUT_SEC=45
CHROMIUM_PATH=/usr/bin/chromium
CHROMEDRIVER_PATH=/usr/bin/chromedriver

# Telegram remote control (controller.py)
TELEGRAM_TOKEN=123456:ABC-from-BotFather
TELEGRAM_CHAT_ID=123456789
PUNCH_DAYS=mon,tue,wed,thu,fri

# Punch windows: a random time is picked inside each window every day.
PUNCH_IN=07:50-08:00
PUNCH_OUT=16:10-16:20
# Lunch during standard time (Nov-Mar) and during DST (Mar-Nov). Leave blank for no lunch punches.
LUNCH_OUT=11:10-11:15
LUNCH_IN=11:25-11:35
LUNCH_OUT_DST=12:10-12:15
LUNCH_IN_DST=12:25-12:35
# Lunch length is always kept within these minutes (measured between the real clicks)
LUNCH_MIN=20
LUNCH_MAX=30

# Start clockbot this many minutes early; it waits on the punch page until the exact time
PUNCH_LEAD_MIN=10
# Never start a punch more than this many minutes late (e.g. after a reboot)
PUNCH_GRACE_MIN=5
